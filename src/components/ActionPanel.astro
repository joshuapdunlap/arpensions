---
const url='https://actionnetwork.org/petitions/stand-for-pension-integrity?source=arpensions';
---
<section class="action-panel" aria-labelledby="petition-heading" id="petition"><span id="sign-the-petition"></span><h2 id="petition-heading" class="sr-only">Sign the petition</h2><div class="actions"><a class="button" href={url}>Open the petition</a><button class="button secondary" id="load-petition" hidden>Load petition here</button></div><p class="footnote">Hosted by Action Network. Email updates are selected by default; review “Edit Subscription Preferences” before signing. <a href="/privacy/">Privacy and subscription details</a>.</p><p id="petition-status" role="status" aria-live="polite"></p><div id="petition-container"></div><noscript><p>The direct petition link works without JavaScript on this site.</p></noscript></section>
<script>
  const button=document.querySelector<HTMLButtonElement>('#load-petition');
  if(button){button.hidden=false;button.addEventListener('click',()=>{button.disabled=true;const status=document.querySelector('#petition-status');const container=document.querySelector('#petition-container');if(status)status.textContent='Loading Action Network. The direct petition link remains available.';const frame=document.createElement('iframe');frame.className='petition-frame';frame.title='Pension Investment Integrity Act petition on Action Network';frame.src='https://actionnetwork.org/petitions/stand-for-pension-integrity?source=arpensions';frame.referrerPolicy='strict-origin-when-cross-origin';frame.addEventListener('load',()=>{if(status)status.textContent='If the form is blank, blocked, or difficult to use, open the petition with the link above.'});container?.append(frame);window.setTimeout(()=>{if(status)status.textContent='If the form does not appear, use Open the petition above. Your signature is handled by Action Network.'},10000)},{once:true})}
</script>
