---
import Base from '../../../layouts/Base.astro';
import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {sources,sourceDateLabel} from '../../../lib/data';
import {assets} from '../../../lib/assets';
import catalog from '../../../data/download-catalog.json';
import revisionData from '../../../data/download-revisions.json';
import LegacyContext from '../../../components/LegacyContext.astro';
const revisions=revisionData as Record<string,{originalSha256:string;replacementSha256:string;reviewedAt:string;reason:string;originalRetained:string}>;
const categories=[...new Set(catalog.map(item=>item.category))];
const pdfCount=catalog.filter(item=>item.url.endsWith('.pdf')).length;
const textCount=catalog.filter(item=>item.url.endsWith('.txt')).length;
---
<Base title="Downloads and historical materials" description="Preserved source PDFs and dated campaign materials, with the current legislative brief clearly identified." section="Documents">
  <div class="shell"><header class="page-heading"><div class="breadcrumbs"><a href="/documents/">Document library</a><span>/</span><span>Downloads</span></div><span class="eyebrow">Complete public download catalog</span><h1>Downloads &<br/>historical materials.</h1><p class="lede">{pdfCount} PDFs and {textCount} text downloads, including source exhibits, alternate extracts and campaign materials. These are published files and versions, not a count of the research archive.</p></header>
    <div class="notice"><strong>Current campaign brief:</strong> <a href="/assets/documents/pension-investment-integrity-act-brief-2026-09-17.pdf">Pension Investment Integrity Act, September 17, 2026 (PDF)</a>. <a href="/legislators/one-page/">Read the accessible web version</a>.</div>
    <nav class="browse-links" aria-label="Download categories">{categories.map(category=><a href={`#${category.toLowerCase().replaceAll(' ','-')}`}>{category} ({catalog.filter(item=>item.category===category).length})</a>)}</nav>
    {categories.map(category=><section class="section" id={category.toLowerCase().replaceAll(' ','-')}><h2>{category}</h2><ul class="document-list">{catalog.filter(item=>item.category===category).map(item=>{
      const source=item.sourceId?sources[item.sourceId]:undefined;
      const asset=item.sourceId?assets[item.sourceId]:undefined;
      const revision=revisions[item.url];
      const digest=createHash('sha256').update(readFileSync(`public${item.url}`)).digest('hex');
      return <li class="document-entry" id={item.contextId}><span class="micro">{item.url.endsWith('.pdf')?'PDF':'TEXT'}</span><div class="entry-body"><h3><a href={source?.recordUrl||item.url}>{item.title} ↗</a></h3><p>{source?.summary||item.scope}</p>{source&&<p>{sourceDateLabel(source)}{source.receivedDate&&` · Received ${source.receivedDate}`}</p>}<LegacyContext contextId={item.contextId}/><details><summary>Provenance and download history</summary><p>{asset?.treatment||item.provenance}</p>{source&&<p>{source.locator}. <a href={source.recordUrl}>Full source record ↗</a></p>}{item.relatedSourceId&&<p><a href={sources[item.relatedSourceId].recordUrl}>Read the reviewed source context ↗</a></p>}<p>Public file SHA-256: <code class="catalog-hash">{digest}</code></p>{revision&&<><p><strong>Privacy revision · {revision.reviewedAt}.</strong> {revision.reason} {revision.originalRetained}</p><p>Original public SHA-256: <code class="catalog-hash">{revision.originalSha256}</code></p></>}</details></div><span class="record-date"><a href={item.url} download>Download ↓</a><a href={`#${item.contextId}`}>Link to context</a></span></li>})}</ul></section>)}
  </div>
</Base>
<style>.catalog-hash{overflow-wrap:anywhere;font-size:.8rem}.entry-body{min-width:0}.document-entry details{margin-top:1rem}.document-entry details p{margin-top:.8rem}.record-date a{display:block;margin-bottom:.75rem}</style>
