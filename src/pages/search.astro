---
import Base from '../layouts/Base.astro';
---
<Base title="Search the public record" description="Search the campaign, findings, and reviewed source transcripts. Browse the public document library by agency and document type." section="Search" noindex>
  <div class="shell"><header class="page-heading"><span class="eyebrow">Your way into the record</span><h1>Find the fact.<br/>Follow the source.</h1><p class="lede">Search public pages and reviewed source text. Everything here can also be reached through the library and evidence pages.</p></header>
  <section class="search-panel" aria-label="Site search"><form id="site-search" role="search"><div class="field"><label for="search-query">Search terms</label><input type="search" id="search-query" name="q" placeholder="Try “APERS”, “credit analysis”, or “funding”" autocomplete="off"/></div><div class="filters" id="search-filters" hidden><div class="field"><label for="search-agency">Agency</label><select id="search-agency"><option value="">All agencies</option></select></div><div class="field"><label for="search-section">Section</label><select id="search-section"><option value="">All sections</option></select></div><div class="field"><label for="search-type">Document type</label><select id="search-type"><option value="">All document types</option></select></div></div><button class="button" type="submit">Search the site</button></form><p class="search-status" role="status" id="search-status">Enter a term to search. Search is processed on your device.</p><ol class="search-results" id="search-results"></ol><nav class="pagination" id="search-pagination" aria-label="Search result pages"></nav><noscript><div class="notice">Interactive search needs JavaScript. Browse the <a href="/documents/">document library</a>, <a href="/evidence/">agency evidence</a>, or <a href="/glossary/">glossary</a>.</div></noscript><nav class="browse-links" aria-label="Browse without search"><a href="/documents/">Browse documents ↗</a><a href="/evidence/">Explore the evidence ↗</a><a href="/glossary/">Look up a term ↗</a></nav></section></div>
</Base>
<script is:inline type="module" src="/assets/scripts/search.js"></script>
