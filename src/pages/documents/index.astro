---
import Base from '../../layouts/Base.astro';
import {sources,sourceDateLabel} from '../../lib/data';
const records=Object.entries(sources).sort(([,a],[,b])=>(b.date||b.receivedDate||'').localeCompare(a.date||a.receivedDate||''));
const agencies=[...new Set(records.map(([,s])=>s.agency))].sort();
const types=[...new Set(records.map(([,s])=>s.documentType))].sort();
const subjects=[...new Set(records.map(([,s])=>s.subject))].sort();
const years=[...new Set(records.map(([,s])=>(s.date||s.receivedDate||'').slice(0,4)).filter(Boolean))].sort().reverse();
---
<Base title="The public document library" description="Browse the reviewed public records behind the campaign: pension decisions, funding, holdings, advice, and the Treasury comparison." section="Documents">
  <div class="shell"><header class="page-heading"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Documents</span></div><span class="eyebrow">Follow a claim to its source</span><h1>The public<br/>document library.</h1><p class="lede">The record, its date, and what it establishes. Browse by agency, type, or a word in the title. Every exhibit identifies its publication treatment. Year filters use the labeled source date, or the received year for an undated source.</p></header>
    <form class="filters" id="library-filters" role="search"><div class="field"><label for="document-query">Search these records</label><input disabled id="document-query" type="search" name="q" placeholder="Try “funding” or “Aon”"/></div><div class="field"><label for="document-agency">Agency</label><select disabled id="document-agency" name="agency"><option value="">All agencies</option>{agencies.map(a=><option>{a}</option>)}</select></div><div class="field"><label for="document-type">Document type</label><select disabled id="document-type" name="type"><option value="">All types</option>{types.map(t=><option>{t}</option>)}</select></div><div class="field"><label for="document-year">Year</label><select disabled id="document-year" name="year"><option value="">All years</option>{years.map(y=><option>{y}</option>)}</select></div><div class="field"><label for="document-subject">Subject</label><select disabled id="document-subject" name="subject"><option value="">All subjects</option>{subjects.map(s=><option>{s}</option>)}</select></div></form><noscript><p class="notice">Filtering needs JavaScript. All public records are listed below. Dates are labeled by what they describe.</p></noscript>
    <p class="results-count" id="document-count" role="status">{records.length} public source records</p>
    <ul class="document-list">{records.map(([,s])=>{return <li class="document-entry" data-search={`${s.title} ${s.summary} ${s.locator} ${s.date||''} ${s.receivedDate||''} ${s.dateNote}`.toLowerCase()} data-agency={s.agency} data-type={s.documentType} data-year={(s.date||s.receivedDate||'').slice(0,4)} data-subject={s.subject}><span class="micro">{s.agency}</span><div><h2><a href={s.recordUrl}>{s.title} ↗</a></h2><p>{s.summary}</p></div><div class="record-date"><span>{sourceDateLabel(s)}</span>{s.receivedDate&&<span class="record-type">Received {s.receivedDate}</span>}<span class="record-type">{s.documentType}</span></div></li>})}</ul>
    <div class="empty-state" id="document-empty" hidden><h2>No records match.</h2><p>Try fewer words or choose all agencies. <button class="text-link" id="reset-library">Reset filters</button>.</p></div>
    <section class="section" style="padding-top:0"><span class="eyebrow">Publication context</span><h2 id="a-curated-source-trail">A curated source trail.</h2><p style="margin-top:24px">This curated library includes reviewed source exhibits and official external references. The complete public download catalog separately identifies source files, alternate extracts, supplemental historical evidence and campaign materials. The complete research corpus contains material that is unsuitable for public distribution. <a href="/methodology/">Read how sources are reviewed</a>.</p><h3 id="additional-hosted-records" style="margin-top:32px">Earlier downloads and historical materials</h3><p style="margin-top:18px">Existing source PDFs and dated campaign materials remain available. Historical briefs describe an earlier evidence snapshot and should be read in that context. <a href="/assets/documents/">Browse the complete public download catalog</a> or <a href="/legislators/one-page/">read the current brief</a>.</p><h3 id="official-legal-record" style="margin-top:32px">Official legal and regulatory sources</h3><p style="margin-top:18px">Source locators distinguish regulatory history from findings about a particular investment. <a href="/findings/regulatory-record/">Read the scope of the regulatory finding</a>.</p></section>
  </div>
</Base>
<script>
  const form=document.querySelector<HTMLFormElement>('#library-filters');
  if(form){form.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select').forEach(control=>control.disabled=false);const query=document.querySelector<HTMLInputElement>('#document-query')!;const agency=document.querySelector<HTMLSelectElement>('#document-agency')!;const type=document.querySelector<HTMLSelectElement>('#document-type')!;const year=document.querySelector<HTMLSelectElement>('#document-year')!;const subject=document.querySelector<HTMLSelectElement>('#document-subject')!;const params=new URLSearchParams(location.search);query.value=params.get('q')||'';agency.value=params.get('agency')||'';type.value=params.get('type')||'';year.value=params.get('year')||'';subject.value=params.get('subject')||'';
    const filter=()=>{let count=0;document.querySelectorAll<HTMLElement>('.document-entry').forEach(row=>{const match=(row.dataset.search||'').includes(query.value.trim().toLowerCase())&&(!agency.value||row.dataset.agency===agency.value)&&(!type.value||row.dataset.type===type.value)&&(!year.value||row.dataset.year===year.value)&&(!subject.value||row.dataset.subject===subject.value);row.hidden=!match;if(match)count++});document.querySelector('#document-count')!.textContent=`${count} public source record${count===1?'':'s'}`;document.querySelector<HTMLElement>('#document-empty')!.hidden=count!==0;const search=new URLSearchParams();if(query.value)search.set('q',query.value);if(agency.value)search.set('agency',agency.value);if(type.value)search.set('type',type.value);if(year.value)search.set('year',year.value);if(subject.value)search.set('subject',subject.value);history.replaceState(null,'',`${location.pathname}${search.size?'?'+search:''}`)};
    form.addEventListener('submit',e=>{e.preventDefault();filter()});form.addEventListener('input',filter);document.querySelector('#reset-library')?.addEventListener('click',()=>{form.reset();filter();query.focus()});filter();
  }
</script>
