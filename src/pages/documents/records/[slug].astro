---
import Base from '../../../layouts/Base.astro';
import {sources,data} from '../../../lib/data';
import {assets} from '../../../lib/assets';
import {getCollection} from 'astro:content';
export function getStaticPaths(){return Object.entries(sources).filter(([,s])=>s.recordUrl.startsWith('/documents/records/')).map(([id,source])=>({params:{slug:source.recordUrl.split('/').filter(Boolean).at(-1)},props:{id,source}}))}
const {id,source}=Astro.props;
const asset=assets[id];
const assetUrl=asset?.assetUrl||source.assetUrl;
const citation=`${source.agency}. ${source.title}. Record date: ${source.date}. ${source.locator}. https://arpensions.org${source.recordUrl}`;
const related=(await getCollection('pages')).filter(p=>p.data.sourceIds.includes(id));
---
<Base title={source.title} description={source.summary} section="Documents" type="article">
  <div class="shell">
    <header class="page-heading record-heading"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/documents/">Documents</a><span>/</span><span>{source.agency}</span></div><span class="eyebrow">Source record · {source.agency}</span><h1>{source.title}</h1><p class="lede">{source.summary}</p><div class="page-meta"><span data-pagefind-filter="Agency">{source.agency}</span><span>RECORD DATE {source.date}</span><span data-pagefind-filter="Document type">{source.documentType}</span></div></header>
    <nav class="record-tools" aria-label="Source tools">
      {assetUrl&&<><a class="button" href={assetUrl}>{asset?.format==='email-text'?'Open reviewed text':'Open reviewed PDF'}</a><a class="text-link" href={assetUrl} download>Download ↓</a></>}
      {asset?.transcript&&<a class="text-link" href="#source-text">Source text</a>}
      <a class="text-link" href="#source-citation">Citation</a>
    </nav>
    <div class="record-grid">
      <div class="record-preview">
        {asset?.previews?.length?asset.previews.map((preview,i)=><figure><a href={preview.url} aria-label={`Open full resolution preview ${i+1} of ${source.title}`}><img src={preview.url} width={preview.width} height={preview.height} alt={`Source page ${i+1}: ${preview.caption}`} loading={i===0?'eager':'lazy'}/></a><figcaption>{preview.caption} <a href={preview.url}>Open full resolution ↗</a></figcaption></figure>):asset?.format==='email-text'?<div class="notice"><h2>Reviewed email text</h2><p style="margin-top:18px">The source is an email message. Its reviewed text is reproduced below with private contact and requester details omitted. The original message is preserved in the research archive.</p></div>:<div class="notice"><h2>Follow the precise locator.</h2><p style="margin-top:18px">{source.locator}</p><p style="margin-top:18px">This entry identifies the underlying record. A reviewed page preview is not yet hosted here. <a href="mailto:info@arpensions.org?subject=Source%20record%20request">Request the source record</a>.</p></div>}
        {asset?.transcript&&<details class="transcript" id="source-text" open><summary>Accessible source text</summary><p class="footnote">Text accompanies the visual exhibit. Preserve the source’s labels and context when quoting; consult the page image for formatting.</p><pre>{asset.transcript}</pre></details>}
      </div>
      <aside class="record-details" aria-label="Source details">
        <h2>Read the record in context.</h2><p>{source.locator}</p>
        <section class="source-citation" aria-labelledby="citation-heading" id="source-citation"><h3 id="citation-heading">Cite this record</h3><p id="record-citation">{citation}</p><div class="copy-row"><button type="button" hidden data-copy="record-citation" data-copy-success="Citation copied.">Copy citation</button><span role="status" aria-live="polite"></span></div></section>
        <dl><dt>Institution</dt><dd>{source.agency}</dd><dt>Record date</dt><dd>{source.date}</dd><dt>Original record</dt><dd>{asset?.originalFile||source.originalFile}</dd><dt>Exact locator</dt><dd>{asset?.originalLocator||source.locator}</dd><dt>Publication treatment</dt><dd>{asset?.treatment||source.treatment}</dd><dt>Reviewed</dt><dd>{asset?.reviewedAt||data.reviewedAt}</dd>{asset&&<><dt>Public asset SHA-256</dt><dd><code>{asset.sha256}</code></dd>{asset.pages>0&&<><dt>Public exhibit length</dt><dd>{asset.pages} page{asset.pages===1?'':'s'}</dd></>}</>}</dl>
        {related.length>0&&<><h2>Related reading</h2><nav class="toc" aria-label="Related findings">{related.map(p=><a href={p.data.permalink}>{p.data.title} ↗</a>)}</nav></>}
        <a class="text-link" href="/documents/">Browse all records ↗</a>
      </aside>
    </div>
  </div>
</Base>
