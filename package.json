{
  "name": "arpensions",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "build": "astro build && python scripts/postbuild.py && pagefind --site dist && python scripts/audit_site.py --site-dir dist && python scripts/verify_assets.py",
    "preview": "astro preview --host 127.0.0.1",
    "validate": "python scripts/sync_campaign_content.py && npm run test && npm run check && npm run build",
    "evidence:delta": "python scripts/evidence_delta.py",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/league-spartan": "5.3.0",
    "@fontsource-variable/mulish": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.2",
    "axe-core": "4.13.0",
    "pagefind": "1.5.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
